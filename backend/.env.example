# Sara backend environment variables — copy to .env and fill in real values.

# Server
PORT=3001

# LLM API keys
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key

# Optional model overrides
# CLAUDE_MODEL=claude-sonnet-4-6
# GEMINI_MODEL=gemini-2.5-flash

# Auth — secret used to sign JWTs (use a long, random string)
JWT_SECRET=change-me-to-a-long-random-string

# Auth — allow-listed users as a JSON string of { username: password }
ALLOWED_USERS={"user1":"pass123","user2":"secret456"}
