# kay.ai backend environment variables — copy to .env and fill in real values.

# Server
# Locally defaults to 3001. On Railway this is injected automatically — do not set it.
PORT=3001

# Auth
# Long random string used to sign JWTs. Minimum 32 bytes — the server refuses
# to start otherwise. Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-signing-secret
# JSON map of allowed logins: {"username": "bcrypt-hash"}
# Passwords MUST be bcrypt hashes — plaintext entries are rejected at login
# with a 500 config error. Generate a hash with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
ALLOWED_USERS={"username":"$2b$12$..."}

# Token version for mass-revocation: bump to invalidate all outstanding JWTs
# at once (without rotating JWT_SECRET). Defaults to "1".
# JWT_VERSION=2

# CORS: extra origins appended to the built-in allow-list
# (production Cloudflare client + localhost dev ports), comma-separated.
# CLIENT_ORIGINS=https://staging.example.com

# Database
MONGO_URI=your-mongodb-atlas-connection-string

# LLM API keys
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key

# Cloudflare R2 (S3-compatible) — private bucket for secure file/image uploads.
# All four are required; the backend fails to boot if any is missing.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name

# Optional model overrides
# CLAUDE_MODEL=claude-sonnet-4-6
# GEMINI_MODEL=gemini-2.5-flash


