# Sara backend environment variables — copy to .env and fill in real values.

# Server
PORT=3001

# Database
MONGO_URI=your-mongodb-atlas-connection-string

# LLM API keys
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key

# Cloudflare R2 (S3-compatible) — private bucket for secure file/image uploads.
# All four are required; the backend fails to boot if any is missing.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name

# Optional model overrides
# CLAUDE_MODEL=claude-sonnet-4-6
# GEMINI_MODEL=gemini-2.5-flash


