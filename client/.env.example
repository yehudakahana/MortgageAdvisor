# Sara client environment variables — copy to .env and fill in real values.

# Backend API origin. Leave EMPTY in local dev so requests stay relative and the
# Vite dev proxy (vite.config.ts) forwards /api to http://localhost:3001.
# In production (Cloudflare Pages) set this to the Railway backend URL, e.g.
# VITE_API_URL=https://your-app.up.railway.app
VITE_API_URL=
